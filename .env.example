# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/istore?retryWrites=true&w=majority

# Auth.js
AUTH_SECRET=your-super-secret-key-generate-with-openssl-rand-base64-32

# Em desenvolvimento local, NEXTAUTH_URL/AUTH_URL não são necessários —
# o NextAuth resolve o host a partir da requisição.
# NO DEPLOY (Vercel): NUNCA defina NEXTAUTH_URL/AUTH_URL como http://localhost:3000.
# Se precisar fixar a URL explícita, use a URL pública do deploy, ex.:
# AUTH_URL=https://ms-imports-six.vercel.app